<h2>Login</h2>

<% if (error) { %>
    <p style="color:red"><%= error %></p>
<% } %>

<form action="/login" method="POST">
    <input type="text" name="username" placeholder="Username (pranathi)" required><br><br>
    <input type="password" name="password" placeholder="Password (2007)" required><br><br>
    <button type="submit">Login</button>
</form>
